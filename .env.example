# =============================================================
# Organization Data Platform — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================

# ─── Node Environment ────────────────────────────────────────
NODE_ENV=development

# ─── API Service ─────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# ─── Database & Redis ────────────────────────────────────────
DATABASE_URL=postgresql://odp_user:odp_password@postgres:5432/odp_db?schema=public
REDIS_URL=redis://redis:6379

# ─── Authentication Secrets (REQUIRED) ───────────────────────
# Generate secure 64-char strings (e.g., `openssl rand -hex 32`)
AUTH_ACCESS_SECRET=d8f92a1b4c6e8f0a2c4e6g8i0k2m4o6q8s0u2w4y6a8c0e2g4i6k8m0o2q4s6u8
AUTH_REFRESH_SECRET=a1b3c5d7e9f2a4b6c8d0e2f4a6b8c0d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0a2b4
AUTH_ACCESS_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN=7d

# ─── Storage Configuration (Default: local) ──────────────────
# - "local": Stores all files on local disk in LOCAL_STORAGE_DIR (no cloud credentials needed).
# - "r2": Stores files in Cloudflare R2 bucket (requires R2 credentials below).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/app/storage

# ─── Cloudflare R2 (OPTIONAL - only needed if STORAGE_PROVIDER=r2) ──
# If STORAGE_PROVIDER=local, you can leave all of these empty.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_SIGNED_URL_EXPIRES=3600

# ─── Scraper Worker & Service Token (REQUIRED) ───────────────
# Long-lived JWT for the "scraper-worker" SERVICE_ACCOUNT user.
# Allows the Python scraper worker to report status and save files back to the API.
API_SERVICE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXNxZ3lsdXgwMDAwbHpiNXlkYTkyZTZwIiwidXNlcm5hbWUiOiJzY3JhcGVyLXdvcmtlciIsInJvbGVzIjpbIlNFUlZJQ0VfQUNDT1VOVCJdLCJpYXQiOjE3ODY1NjIxMjQsImV4cCI6MjEwMTkyMjEyNH0.C6X8fJieE1PPgeGRl7_RYGxNZDLcRmCcwWWqbKt9EE8
SCRAPER_WORKER_CONCURRENCY=4
SCRAPER_MAX_FILE_SIZE_MB=500
SCRAPER_TEMP_DIR=/tmp/scraper

# ─── Google Gemini API (OPTIONAL - for audio transcription/AI) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Telegram Collector (OPTIONAL - only if scraping Telegram) ──
# Obtain API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ─── Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ─── PostgreSQL (Docker Compose) ─────────────────────────────
POSTGRES_USER=odp_user
POSTGRES_PASSWORD=odp_password
POSTGRES_DB=odp_db
