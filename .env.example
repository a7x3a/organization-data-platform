# =============================================================
# Organization Data Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ─── Node Environment ────────────────────────────────────────
NODE_ENV=development

# ─── API ─────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://odp_user:odp_password@postgres:5432/odp_db?schema=public

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -base64 64
AUTH_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_MIN
AUTH_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET_64_CHARS_MIN
AUTH_ACCESS_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN=7d

# ─── Storage ──────────────────────────────────────────────────
# local: works with zero R2 credentials (default, recommended for dev/test).
# r2: requires the Cloudflare R2 block below to be filled in with real values.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/app/storage

# ─── Cloudflare R2 (only used when STORAGE_PROVIDER=r2) ──────
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=organization-data
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_REGION=auto
# Signed URL expiry in seconds (default: 3600 = 1 hour)
R2_SIGNED_URL_EXPIRES=3600

# ─── Scraper Worker ──────────────────────────────────────────
SCRAPER_WORKER_CONCURRENCY=4
SCRAPER_MAX_FILE_SIZE_MB=500
SCRAPER_TEMP_DIR=/tmp/scraper

# ─── Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ─── PostgreSQL (Docker Compose only) ────────────────────────
POSTGRES_USER=odp_user
POSTGRES_PASSWORD=odp_password
POSTGRES_DB=odp_db
