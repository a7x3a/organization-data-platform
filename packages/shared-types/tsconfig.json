{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./dist", "./tests"]
}